{
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/explore", "destination": "/global", "permanent": true },
    { "source": "/adventure", "destination": "/outdoors", "permanent": true },
    { "source": "/plan", "destination": "/", "permanent": true },
    { "source": "/story", "destination": "/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/global", "destination": "/" },
    { "source": "/outdoors", "destination": "/" },
    { "source": "/bucket-list", "destination": "/" },
    { "source": "/local", "destination": "/" },
    { "source": "/good-news", "destination": "/" },
    { "source": "/when", "destination": "/" },
    { "source": "/lads", "destination": "/" },
    { "source": "/gift/:slug*", "destination": "/" },
    { "source": "/rome", "destination": "/" },
    { "source": "/australia", "destination": "/" },
    { "source": "/prague", "destination": "/" },
    { "source": "/dublin", "destination": "/" },
    { "source": "/michigan", "destination": "/" },
    { "source": "/spain", "destination": "/" },
    { "source": "/iceland", "destination": "/" },
    { "source": "/munich", "destination": "/" },
    { "source": "/poland", "destination": "/" },
    { "source": "/thailand", "destination": "/" },
    { "source": "/charleston", "destination": "/" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
